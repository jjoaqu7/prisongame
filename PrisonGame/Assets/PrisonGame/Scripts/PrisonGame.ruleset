<?xml version="1.0" encoding="utf-8"?>
<!-- Shared analyzer severities for new code (docs/engineering-standards.md). This file is the master copy.
     Every PrisonGame assembly definition folder holds an identical copy named <AssemblyName>.ruleset, for
     example PrisonGame.Combat.ruleset (Unity applies a ruleset only when it sits beside that assembly's
     .asmdef and carries the assembly's name, so the prototype is unaffected, and Unity's compiler
     does not follow ruleset includes). tools/check.ps1 fails if a copy is missing or differs. Microsoft.Unity.Analyzers rules are suggestions
     by default, which the Unity Console never shows; they become warnings here. UNT0021 (make Unity
     messages protected) stays off: private Unity messages are the common convention. -->
<RuleSet Name="PrisonGame new code" Description="Unity analyzer rules raised to warnings for Assets/PrisonGame" ToolsVersion="17.0">
  <Rules AnalyzerId="Microsoft.Unity.Analyzers" RuleNamespace="Microsoft.Unity.Analyzers">
    <Rule Id="UNT0001" Action="Warning" />
    <Rule Id="UNT0002" Action="Warning" />
    <Rule Id="UNT0003" Action="Warning" />
    <Rule Id="UNT0004" Action="Warning" />
    <Rule Id="UNT0005" Action="Warning" />
    <Rule Id="UNT0006" Action="Warning" />
    <Rule Id="UNT0007" Action="Warning" />
    <Rule Id="UNT0008" Action="Warning" />
    <Rule Id="UNT0009" Action="Warning" />
    <Rule Id="UNT0010" Action="Warning" />
    <Rule Id="UNT0011" Action="Warning" />
    <Rule Id="UNT0012" Action="Warning" />
    <Rule Id="UNT0013" Action="Warning" />
    <Rule Id="UNT0014" Action="Warning" />
    <Rule Id="UNT0015" Action="Warning" />
    <Rule Id="UNT0016" Action="Warning" />
    <Rule Id="UNT0017" Action="Warning" />
    <Rule Id="UNT0018" Action="Warning" />
    <Rule Id="UNT0019" Action="Warning" />
    <Rule Id="UNT0020" Action="Warning" />
    <Rule Id="UNT0022" Action="Warning" />
    <Rule Id="UNT0023" Action="Warning" />
    <Rule Id="UNT0024" Action="Warning" />
    <Rule Id="UNT0025" Action="Warning" />
    <Rule Id="UNT0026" Action="Warning" />
    <Rule Id="UNT0027" Action="Warning" />
    <Rule Id="UNT0028" Action="Warning" />
    <Rule Id="UNT0029" Action="Warning" />
    <Rule Id="UNT0030" Action="Warning" />
