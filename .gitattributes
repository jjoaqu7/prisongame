# Normalize text for stable diffs; leave binary assets untouched.
* text=auto
*.md text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
# Git's shell runs hooks; CRLF would break the #!/bin/sh line.
.githooks/* text eol=lf

# Git LFS for large binary art and audio (docs/engineering-standards.md). File types not yet in the
# repository go through LFS everywhere. png, jpg, wav and mp3 already exist as ordinary files, so for them
# LFS applies only to the new-content folder; existing files and history stay as they are.
*.psd filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.aif filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
PrisonGame/Assets/PrisonGame/**/*.png filter=lfs diff=lfs merge=lfs -text
PrisonGame/Assets/PrisonGame/**/*.jpg filter=lfs diff=lfs merge=lfs -text
PrisonGame/Assets/PrisonGame/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
PrisonGame/Assets/PrisonGame/**/*.wav filter=lfs diff=lfs merge=lfs -text
PrisonGame/Assets/PrisonGame/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
